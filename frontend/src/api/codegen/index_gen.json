  "components": {
    "schemas": {
      "ApiInfoBindingModel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "nullable": true
          },
          "systemEnvironment": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "BasicRoleBindingModel": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "BasicSkillBindingModel": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "BasicSupplyCertificateWorkflowBindingModel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "$ref": "#/components/schemas/SupplyCertificateWorkflowStateType"
          }
        }
      },
      "BasicUserBindingModel": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayName",
          "id",
          "userName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userName": {
            "type": "string",
            "nullable": true
          },
          "displayName": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ChangeOwnPasswordBindingModel": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 2500,
            "minLength": 0,
            "nullable": true
          },
          "newPassword": {
            "type": "string",
            "maxLength": 2500,
            "minLength": 0,
            "nullable": true
          }
        }
      },
      "CreateRoleBindingModel": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "maxLength": 2500,
            "minLength": 0,
            "nullable": true
          }
        }
      },
      "CreateSkillBindingModel": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CreateUpdateDataSourceBindingModel": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "requiredSkillIds": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "CreateUserBindingModel": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayName",
          "password",
          "userName"
